  "1369": "*흠",
  "1370": "*이건...",
  "1371": "*훌륭하군",
  "1372": "*틀림없어",
  "1373": "*도코요가 깃든 복제 두뇌다",
  "1374": "*이렇게나 소중히 안겨 있는데",
  "1375": "*설마...",
  "1376": "*어이",
  "1377": "*이놈이 누군지 알겠나?",
  "1378": "*그게 말입니다",
  "1379": "*떨어진 건지 뗀 건지",
  "1380": "*이름표를 찾을 수가 없어서 말입니다",
  "1381": "*그런 건 보면 알아",
  "1382": "*그러니까 후보를 대라는 거잖아",
  "1383": "*머리 좀 써",
  "1384": "*옛!",
  "1385": "*쓸모없는 놈",
  "1386": "*넌 어떠냐?",
  "1387": "*옛!",
  "1388": "*이틀 전부터 사사나리 제7연대가",
  "1389": "*일대에서 설중 행군 훈련을 실시 중입니다",
  "1390": "*제7 통신탑 통과 보고를 확인한 결과",
  "1391": "*시게오 이등병",
  "1392": "*카즈토시 일등병",
  "1393": "*마사시 일등병",
  "1394": "*이상 세 명이 행방불명된 것으로 확인됐다고 합니다",
  "1395": "*그중 한 명이라는 건",
  "1396": "*위치상 충분히 가능하다고 판단됩니다",
  "1397": "*그렇군",
  "1398": "*잠깐",
  "1399": "*이놈 죽지 않았어",
  "1400": "*예",
  "1401": "*가사 상태인 듯합니다",
  "1402": "*그걸 먼저 말했어야지 이 새끼야",
  "1403": "*복제 두뇌와 함께 이놈도 데려가",
  "1404": "*지금 당장",
  "1405": "*옛!",
  "1406": "*소생시켜서 정보를 캐내라",
  "1407": "*우리나라의 운명이 걸렸다고 생각해라",
  "1408": "*너희 절대로 죽이지 마라",
  "1409": "*옛!",
  "1410": "끝"
}
